# Copy to /etc/ngfw/proxy.env, owned root:ngfw-proxy and mode 0640.
# Limits/policies are fetched from the engine; these are deployment paths only.
# Listeners remain closed until verified T01/T06/T07/T28 activation is available.
NGFW_REQUEST_GATE_SOCKET=/run/ngfw/request-gate.sock
NGFW_PROXY_CA_CERT=/var/lib/ngfw/ca/ca.crt
NGFW_PROXY_CA_KEY=/var/lib/ngfw/ca/ca.key
NGFW_SURICATA_BINARY=/usr/bin/suricata
NGFW_REQUEST_WORKER_CONFIG=/etc/ngfw/request-gate/suricata.yaml
NGFW_REQUEST_WORKER_ROOT=/var/lib/ngfw/request-workers
