# Copy to /etc/ngfw/ngfw.env and adapt interface names/addresses in the config.
NGFW_STATE_DIR=/var/lib/ngfw
NGFW_CONFIG=/etc/ngfw/lab.json
NGFW_ENGINE_SOCKET=/run/ngfw/engine.sock
NGFW_INSPECTION_MANIFEST=/etc/ngfw/inspection/manifest.json
NGFW_INSPECTION_ROOT=/var/lib/ngfw/inspection
NGFW_SURICATA_BINARY=/usr/bin/suricata
NGFW_EVE_ROTATE_BYTES=33554432
NGFW_INSPECTION_RETENTION_BYTES=268435456
NGFW_INSPECTION_RETENTION_DAYS=1
NGFW_EVE_ROTATION_GRACE_SECONDS=120
NGFW_API_ADDR=:8080
NGFW_API_TOKEN=replace-with-a-lab-only-token
